{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Registered user/worker in the Task and Esports Arena system with unique identifier and INR earnings balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "uniqueUserId": { "type": "string", "maxLength": 100 },
        "eid": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["worker", "admin", "partner"] },
        "availableBalanceINR": { "type": "number" },
        "totalEarnedINR": { "type": "number" },
        "lifetimeEarnedINR": { "type": "number" },
        "completedTasksCount": { "type": "number" },
        "totalTasksCompleted": { "type": "number" },
        "accuracyRate": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 50 },
        "joinedDate": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "upiId": { "type": "string", "maxLength": 200 },
        "avatarUrl": { "type": "string", "maxLength": 2000 },
        "googleAccount": { "type": "object" },
        "esportsTournamentUid": { "type": "string", "maxLength": 100 },
        "inGameName": { "type": "string", "maxLength": 100 },
        "inGameUid": { "type": "string", "maxLength": 100 },
        "gamingPreferences": { "type": "object" },
        "hasTournamentProfile": { "type": "boolean" },
        "tournamentProfileCreatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "uniqueUserId", "name", "email", "availableBalanceINR"]
    },
    "Task": {
      "title": "Task",
      "description": "A task provided by a partner organization for workers to complete.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "partnerId": { "type": "string", "maxLength": 100 },
        "partnerName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "payINR": { "type": "number" },
        "timeEstimateMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "totalQuota": { "type": "number" },
        "completedQuota": { "type": "number" },
        "instructions": { "type": "string", "maxLength": 5000 },
        "validationCriteria": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "taskLink": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "partnerId", "title", "payINR", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A worker's submitted proof for completing a task.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "taskId": { "type": "string", "maxLength": 100 },
        "taskTitle": { "type": "string", "maxLength": 250 },
        "workerId": { "type": "string", "maxLength": 100 },
        "workerName": { "type": "string", "maxLength": 200 },
        "workerUniqueUserId": { "type": "string", "maxLength": 100 },
        "partnerId": { "type": "string", "maxLength": 100 },
        "partnerName": { "type": "string", "maxLength": 200 },
        "payINR": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "maxLength": 100 },
        "reviewedAt": { "type": "string", "maxLength": 100 },
        "reviewerRole": { "type": "string", "maxLength": 50 },
        "proofText": { "type": "string", "maxLength": 10000 },
        "feedback": { "type": "string", "maxLength": 1000 },
        "proofImage": { "type": "string", "maxLength": 10000000 }
      },
      "required": ["id", "taskId", "workerId", "payINR", "status", "submittedAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Payout request generated by a worker to receive their INR balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "workerId": { "type": "string", "maxLength": 100 },
        "workerName": { "type": "string", "maxLength": 200 },
        "workerUniqueUserId": { "type": "string", "maxLength": 100 },
        "amountINR": { "type": "number" },
        "upiId": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending", "processed", "rejected"] },
        "requestedAt": { "type": "string", "maxLength": 100 },
        "processedAt": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "workerId", "amountINR", "upiId", "status", "requestedAt"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Prepaid gift or bonus voucher code redeemable for INR balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 100 },
        "amountINR": { "type": "number" },
        "isRedeemed": { "type": "boolean" },
        "redeemedByWorkerId": { "type": "string", "maxLength": 100 },
        "redeemedByName": { "type": "string", "maxLength": 200 },
        "redeemedAt": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "code", "amountINR", "isRedeemed"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global configuration and operational parameters for Task and Esports Arena.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "maintenanceMode": { "type": "boolean" },
        "showBanner": { "type": "boolean" },
        "bannerBrandingText": { "type": "string", "maxLength": 500 },
        "minimumWithdrawalINR": { "type": "number" },
        "taskAutoApproveEnabled": { "type": "boolean" },
        "partnerPIN": { "type": "string", "maxLength": 20 },
        "adminPIN": { "type": "string", "maxLength": 20 }
      },
      "required": ["id"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Esports gaming tournament with specific game modes, prize pools and scheduling.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 250 },
        "game": { "type": "string", "maxLength": 100 },
        "gameMode": { "type": "string", "enum": ["Solo", "Battle Royale", "Squad", "Lone Wolf", "Craftland", "1v1", "3v3", "2v2"] },
        "bannerUrl": { "type": "string", "maxLength": 2000 },
        "prizePoolINR": { "type": "number" },
        "firstPrizeINR": { "type": "number" },
        "secondPrizeINR": { "type": "number" },
        "thirdPrizeINR": { "type": "number" },
        "perKillINR": { "type": "number" },
        "entryFeeINR": { "type": "number" },
        "map": { "type": "string", "maxLength": 100 },
        "maxSlots": { "type": "number" },
        "registeredSlots": { "type": "number" },
        "scheduleDate": { "type": "string", "maxLength": 100 },
        "scheduleTime": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "roomId": { "type": "string", "maxLength": 100 },
        "roomPassword": { "type": "string", "maxLength": 100 },
        "rules": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "maxLength": 100 },
        "esportsTournamentUid": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "gameMode", "prizePoolINR", "entryFeeINR", "status"]
    },
    "TournamentParticipant": {
      "title": "TournamentParticipant",
      "description": "Registered player record for a tournament.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "tournamentId": { "type": "string", "maxLength": 100 },
        "workerId": { "type": "string", "maxLength": 100 },
        "workerName": { "type": "string", "maxLength": 200 },
        "workerUid": { "type": "string", "maxLength": 100 },
        "esportsTournamentUid": { "type": "string", "maxLength": 100 },
        "inGameName": { "type": "string", "maxLength": 100 },
        "inGameUid": { "type": "string", "maxLength": 100 },
        "registeredAt": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "tournamentId", "workerId", "inGameName", "inGameUid"]
    }
  },
  "firestore": {
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Collection of all registered workers and users."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Collection of all active and available tasks."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Worker submissions and review records."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Worker payout and withdrawal requests."
    },
    "/vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/Voucher" },
      "description": "Balance redemption vouchers."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configurations."
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Esports tournament events."
    },
    "/tournamentParticipants/{participantId}": {
      "schema": { "$ref": "#/entities/TournamentParticipant" },
      "description": "Tournament participant registrations."
    }
  }
}
